# Line-ending policy — enforced on every checkout, regardless of a contributor's
# core.autocrlf setting. A .bat / .cmd file with LF endings silently breaks cmd.exe
# (it mangles line boundaries), so Windows scripts must always be CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
